{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" busy",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" waiting",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" waiting",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" waiting",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" waiting",
            "async": true,
            "timeout": 5
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" done",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" error",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agentlight.sh\" idle",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
