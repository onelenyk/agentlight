{
  "agentlight": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agentlight/agentlight.sh\" busy agy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_question|ask_permission",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agentlight/agentlight.sh\" busy agy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agentlight/agentlight.sh\" stop agy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
